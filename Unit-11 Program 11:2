#include <iostream>
using namespace std;

int main() {
    cout << "Roll no: 24B11AI023" << endl;
    int num1, num2;
    char op;

    cout << "Simple Calculator" << endl;
    cout << "Enter first number: ";
    cin >> num1;

    cout << "Enter second number: ";
    cin >> num2;

    cout << "Enter an operator (+, -, *, /): ";
    cin >> op;

    try {
        // Check for negative numbers
        if (num1 < 0 || num2 < 0) throw "Negative numbers are not allowed!";

        // Check for division by zero
        if (op == '/' && num2 == 0) throw "Division by zero is not allowed!";

        double result;
        switch(op) {
            case '+': result = num1 + num2; break;
            case '-': result = num1 - num2; break;
            case '*': result = num1 * num2; break;
            case '/': result = static_cast<double>(num1) / num2; break;
            default: throw "Invalid operator!";
        }

        cout << "Result: " << result << endl;
    }
    catch (const char* e) {
        cout << "Error: " << e << endl;
    }

    cout << "Program execution completed successfully." << endl;
    return 0;
}
